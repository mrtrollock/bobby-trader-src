# send_batch.py + briefing.py (public addresses only, no secret needed). Copy to .env (git-ignored).
BOBBY_ACCOUNT_ADDRESS=
ARCUS_ACCOUNT_INDEX=0
# Hyperliquid master address for Entropy (defaults to BOBBY_ACCOUNT_ADDRESS); dexes to include ("io" = Entropy, "main" = main dex)
BOBBY_HL_ADDRESS=
BOBBY_HL_DEXES=io
# TxFlow main wallet address (defaults to BOBBY_ACCOUNT_ADDRESS)
BOBBY_TXFLOW_ADDRESS=
# optional: inbox path (default public/proposals.json)
BOBBY_INBOX=
# The autotrader reads its KEYS from the process environment only (keep them in a chmod 600 file outside the repo):
# AUTOTRADER_NETWORK=testnet AUTOTRADER_ENABLED=0 AUTOTRADER_LIVE=0 ARCUS_API_PRIVATE_KEY= ARCUS_ACCOUNT_ADDRESS=
# HL_AGENT_PRIVATE_KEY= HL_ACCOUNT_ADDRESS=   (see autotrader/README.md)
# QFEX_API_PUBLIC_KEY= QFEX_API_SECRET_KEY= QFEX_ACCOUNT_ID=<subaccount uuid> QFEX_KEY_SINGLE_ACCOUNT_ACK=1
# QFEX_WEEKLY_LOSS_CAP_USD=30 QFEX_MAX_TRADE_LOSS_USD=3
# briefing.py: set BOBBY_QFEX=1 to show the QFEX card (it reads QFEX through `node autotrader/cli.js status`, i.e. needs the key env)
